{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "README.md"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [ { "key": "Cache-Control", "value": "no-cache" } ]
      },
      {
        "source": "/index.html",
        "headers": [ { "key": "Cache-Control", "value": "no-cache" } ]
      },
      {
        "source": "/sw.js",
        "headers": [ { "key": "Cache-Control", "value": "no-cache" } ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [ { "key": "Cache-Control", "value": "no-cache" } ]
      },
      {
        "source": "**/*.png",
        "headers": [ { "key": "Cache-Control", "value": "no-cache" } ]
      }
    ]
  }
}
